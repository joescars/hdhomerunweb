<div id="tuner-status" hx-get="/admin/status/fragment" hx-trigger="load delay:3s" hx-swap="outerHTML">
  <% if (error) { %>
    <div class="alert alert-danger">Could not read tuner status: <%= error %></div>
  <% } else if (!tuners.length) { %>
    <div class="alert alert-secondary">No tuners currently active.</div>
  <% } else { %>
    <% tuners.forEach(function(t, i) { %>
      <div class="card bg-body-tertiary mb-3">
        <div class="card-body">
          <h3 class="h6 card-title"><%= t.Resource || ('Tuner ' + i) %></h3>
          <% if (t.VctNumber) { %>
            <p class="mb-2">Tuned: <strong><%= t.VctNumber %> <%= t.VctName || '' %></strong></p>
          <% } else { %>
            <p class="text-body-secondary mb-0">Idle</p>
          <% } %>
          <% if (typeof t.SignalStrengthPercent !== 'undefined') { %>
            <div class="d-flex align-items-center gap-2 small mb-1">
              <span style="width: 6rem;">Signal</span>
              <div class="progress flex-grow-1" role="progressbar">
                <div class="progress-bar" style="width: <%= t.SignalStrengthPercent %>%"></div>
              </div>
              <span style="width: 3rem;" class="text-end"><%= t.SignalStrengthPercent %>%</span>
            </div>
          <% } %>
          <% if (typeof t.SignalQualityPercent !== 'undefined') { %>
            <div class="d-flex align-items-center gap-2 small mb-1">
              <span style="width: 6rem;">Quality</span>
              <div class="progress flex-grow-1" role="progressbar">
                <div class="progress-bar" style="width: <%= t.SignalQualityPercent %>%"></div>
              </div>
              <span style="width: 3rem;" class="text-end"><%= t.SignalQualityPercent %>%</span>
            </div>
          <% } %>
          <% if (typeof t.SymbolQualityPercent !== 'undefined') { %>
            <div class="d-flex align-items-center gap-2 small mb-1">
              <span style="width: 6rem;">Symbol Q.</span>
              <div class="progress flex-grow-1" role="progressbar">
                <div class="progress-bar" style="width: <%= t.SymbolQualityPercent %>%"></div>
              </div>
              <span style="width: 3rem;" class="text-end"><%= t.SymbolQualityPercent %>%</span>
            </div>
          <% } %>
          <% if (t.NetworkRate) { %><p class="text-body-secondary small mb-0 mt-2">Network rate: <%= (t.NetworkRate * 8 / 1000000).toFixed(1) %> Mbit/s</p><% } %>
        </div>
      </div>
    <% }); %>
  <% } %>
</div>
