<div class="channel-row"
     id="channel-<%= ch.GuideNumber.replace('.', '-') %>"
     data-favorite="<%= ch.Favorite ? 1 : 0 %>"
     data-hd="<%= ch.HD ? 1 : 0 %>"
     data-hidden="<%= ch.Enabled === 0 ? 1 : 0 %>">
  <span class="channel-num"><%= ch.GuideNumber %></span>

  <span class="channel-name text-truncate"><%= ch.GuideName %></span>

  <span class="channel-tags">
    <% if (ch.HD) { %><span class="channel-tag channel-tag-hd">HD</span><% } %>
    <% if (ch.DRM || ch.Subscribed === 0) { %>
      <span class="channel-tag channel-tag-drm" title="Encrypted channel not authorized on this device">DRM</span>
    <% } %>
    <% if (typeof ch.SignalQuality !== 'undefined') { %>
      <span class="channel-tag channel-tag-signal" title="Signal strength <%= ch.SignalStrength %>% / quality <%= ch.SignalQuality %>%">
        <i class="bi bi-reception-4"></i><%= ch.SignalQuality %>%
      </span>
    <% } %>
    <% if (ch.VideoCodec || ch.AudioCodec) { %>
      <span class="channel-tag channel-tag-codec"><%= [ch.VideoCodec, ch.AudioCodec].filter(Boolean).join(' · ') %></span>
    <% } %>
  </span>

  <span class="channel-actions">
    <button type="button" class="icon-btn <%= ch.Favorite ? 'is-active icon-btn-fav' : '' %>"
            title="<%= ch.Favorite ? 'Unfavorite' : 'Favorite' %>"
            hx-post="/admin/channels/flag?guide=<%= encodeURIComponent(ch.GuideNumber) %>&mode=<%= encodeURIComponent(ch.Favorite ? '-' : '+') %>"
            hx-target="#channel-<%= ch.GuideNumber.replace('.', '-') %>" hx-swap="outerHTML">
      <i class="bi <%= ch.Favorite ? 'bi-star-fill' : 'bi-star' %>"></i>
    </button>
    <button type="button" class="icon-btn <%= ch.Enabled === 0 ? 'is-active icon-btn-hidden' : '' %>"
            title="<%= ch.Enabled === 0 ? 'Unhide' : 'Hide' %>"
            hx-post="/admin/channels/flag?guide=<%= encodeURIComponent(ch.GuideNumber) %>&mode=<%= encodeURIComponent(ch.Enabled === 0 ? '-' : 'x') %>"
            hx-target="#channel-<%= ch.GuideNumber.replace('.', '-') %>" hx-swap="outerHTML">
      <i class="bi <%= ch.Enabled === 0 ? 'bi-eye-slash-fill' : 'bi-eye-slash' %>"></i>
    </button>
  </span>
</div>
