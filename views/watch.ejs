<%- include('_client_header', { title: channelName ? `Watch ${channelName}` : 'Watch', bare: embedded }) %>

<% if (embedded) { %>
  <div class="watch-fullbleed">
    <video id="player" controls autoplay playsinline></video>
    <div class="watch-fullbleed-overlay">
      <div id="player-status" class="small"><%= channelName || channel %> &middot; Tuning&hellip;</div>
      <div id="captions-status" class="small">Captions: checking stream...</div>
      <% if (recordEnabled) { %>
        <button type="button" id="record-btn" class="btn btn-sm btn-outline-danger mt-1"><i class="bi bi-record-circle me-1"></i>Record</button>
        <div id="record-status" class="small"></div>
      <% } %>
    </div>
  </div>
<% } else { %>
  <div class="d-flex align-items-center mb-3">
    <a href="/" class="icon-link me-2" title="Back to guide" aria-label="Back to guide"><i class="bi bi-arrow-left"></i></a>
    <h1 class="h5 mb-0">
      <span class="badge text-bg-primary me-2"><%= channel %></span>
      <%= channelName || 'Live' %>
    </h1>
  </div>

  <div class="ratio ratio-16x9 bg-black rounded overflow-hidden mb-3">
    <video id="player" controls autoplay playsinline></video>
  </div>

  <div id="player-status" class="text-body-secondary small">Tuning&hellip; usually just a few seconds.</div>
  <div id="captions-status" class="text-body-secondary small">Captions: checking stream...</div>
  <% if (recordEnabled) { %>
    <button type="button" id="record-btn" class="btn btn-sm btn-outline-danger mt-2"><i class="bi bi-record-circle me-1"></i>Record this airing</button>
    <div id="record-status" class="text-body-secondary small mt-1"></div>
  <% } %>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.17/dist/hls.min.js?v=<%= assetVersion %>"></script>
<script>
  (function () {
    var channel = <%- JSON.stringify(channel) %>;
    var forcedProfile = <%- JSON.stringify(qualityProfile) %>;
    var qualityOptions = <%- JSON.stringify(qualityOptions || []) %>;
    var webvttSidecarEnabled = <%- JSON.stringify(!!webvttSidecarEnabled) %>;
    var video = document.getElementById('player');
    var status = document.getElementById('player-status');
    var captionsStatus = document.getElementById('captions-status');
    var recordBtn = document.getElementById('record-btn');
    var recordStatus = document.getElementById('record-status');
    var profile = chooseProfile();
    var streamBase = '/stream/' + encodeURIComponent(channel) + '/h264/' + encodeURIComponent(profile) + '/';
    var src = streamBase + 'stream.m3u8';
    var POLL_INTERVAL_MS = 500;
    var MAX_WAIT_MS = 30000;
    var HEARTBEAT_INTERVAL_MS = 4000;
    var READY_RETRY_LIMIT = 4;
    var heartbeatTimer = null;

    function setStatus(text) { status.textContent = text; }
    function setCaptionsStatus(text) { captionsStatus.textContent = text; }

    function addWebVttTrack(url) {
      if (!video) return;
      var existing = video.querySelector('track[data-sidecar="webvtt"]');
      if (existing) return;

      var track = document.createElement('track');
      track.kind = 'captions';
      track.label = 'English CC';
      track.srclang = 'en';
      track.src = url;
      track.setAttribute('data-sidecar', 'webvtt');
      video.appendChild(track);
    }

    function tryAttachWebVttTrack(attempt) {
      if (!webvttSidecarEnabled) {
        setCaptionsStatus('Captions: sidecar disabled on server.');
        return;
      }

      var captionsUrl = streamBase + 'captions.vtt?t=' + Date.now();
      fetch(captionsUrl, { cache: 'no-store' })
        .then(function (r) {
          if (!r.ok) throw new Error('sidecar_not_ready');
          return r.text();
        })
        .then(function (text) {
          if (!/WEBVTT/.test(text || '')) throw new Error('invalid_sidecar');
          addWebVttTrack(captionsUrl);
          setCaptionsStatus('Captions: WebVTT sidecar attached. Use CC/subtitles control to enable when cues are present.');
          setTimeout(refreshCaptionsStatus, 500);
        })
        .catch(function () {
          if ((attempt || 0) < 8) {
            setTimeout(function () { tryAttachWebVttTrack((attempt || 0) + 1); }, 1000);
            return;
          }
          setCaptionsStatus('Captions: no caption cues detected for this stream yet.');
        });
    }

    function getCaptionTrackSources() {
      var sources = { embedded: false, sidecar: false };
      if (!video || !video.textTracks) return sources;
      for (var i = 0; i < video.textTracks.length; i += 1) {
        var track = video.textTracks[i];
        var trackKind = (track.kind || '').toLowerCase();
        if (trackKind !== 'captions' && trackKind !== 'subtitles') continue;
        if (track.label === 'English CC') {
          sources.sidecar = true;
        } else {
          // hls.js creates in-band CEA-608 tracks directly on video.textTracks
          // without the sidecar's distinguishing label/data-sidecar attribute.
          sources.embedded = true;
        }
      }
      return sources;
    }

    function refreshCaptionsStatus() {
      var sources = getCaptionTrackSources();
      if (sources.embedded && sources.sidecar) {
        setCaptionsStatus('Captions: embedded CEA-608 track and WebVTT sidecar track both detected. Use player CC/subtitles control to choose one.');
      } else if (sources.embedded) {
        setCaptionsStatus('Captions: embedded CEA-608 track detected. Use player CC/subtitles control to enable.');
      } else if (sources.sidecar) {
        setCaptionsStatus('Captions: WebVTT sidecar track attached. Use player CC/subtitles control to enable when cues are present.');
      } else {
        setCaptionsStatus('Captions: no track detected yet.');
      }
    }

    function bindCaptionTrackListeners() {
      if (!video || !video.textTracks || !video.textTracks.addEventListener) return;
      video.textTracks.addEventListener('addtrack', refreshCaptionsStatus);
      video.textTracks.addEventListener('removetrack', refreshCaptionsStatus);
      video.textTracks.addEventListener('change', refreshCaptionsStatus);
    }

    function chooseProfile() {
      if (qualityOptions.indexOf(forcedProfile) !== -1) {
        return forcedProfile;
      }

      var connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      if (!connection) return 'medium';
      if (connection.saveData) return 'low';

      var effectiveType = connection.effectiveType || '';
      if (effectiveType === 'slow-2g' || effectiveType === '2g' || effectiveType === '3g') {
        return 'low';
      }

      if (typeof connection.downlink === 'number' && connection.downlink >= 8) {
        return 'high';
      }
      if (typeof connection.downlink === 'number' && connection.downlink <= 2.5) {
        return 'low';
      }
      return 'medium';
    }

    function sendHeartbeat() {
      fetch(streamBase + 'heartbeat', { method: 'POST', keepalive: true }).catch(function () {});
    }

    function startHeartbeat() {
      if (heartbeatTimer) return;
      sendHeartbeat();
      heartbeatTimer = setInterval(sendHeartbeat, HEARTBEAT_INTERVAL_MS);
    }

    function stopHeartbeat() {
      if (!heartbeatTimer) return;
      clearInterval(heartbeatTimer);
      heartbeatTimer = null;
    }

    window.addEventListener('pagehide', stopHeartbeat);

    function streamFailureText(error) {
      var detail = String(error || '');
      if (/resource busy|device or resource busy|tuner|already in use/i.test(detail)) {
        return 'Tuner is busy. Stop another stream and try again.';
      }
      if (/timed out|timeout/i.test(detail)) {
        return 'Stream startup timed out. Retrying may help.';
      }
      return 'Stream failed to start. It may be in use by another tuner, or the channel may be unavailable.';
    }

    // By the time playback actually starts (after the async tune/poll
    // sequence), the original tap's "user gesture" window has long closed -
    // browsers (especially iOS Safari) block autoplay of unmuted video
    // without one. Try with sound first (works if the browser/site already
    // has autoplay permission, e.g. from a prior visit); if that's
    // rejected, fall back to muted autoplay, which is always allowed, so
    // the video at least starts immediately rather than sitting on the
    // first frame until the user manually hits the native play button.
    // Sound is one tap away via the existing native mute control either way.
    function attemptAutoplay() {
      var playPromise = video.play();
      if (playPromise && typeof playPromise.catch === 'function') {
        playPromise.catch(function () {
          video.muted = true;
          video.play().catch(function () {});
        });
      }
    }

    function playHls() {
      if (window.Hls && Hls.isSupported()) {
        var hls = new Hls({
          lowLatencyMode: true,
          liveSyncDurationCount: 2,
          maxBufferLength: 10,
          backBufferLength: 30
        });
        hls.loadSource(src);
        hls.attachMedia(video);
        hls.on(Hls.Events.MANIFEST_PARSED, function () {
          setStatus('Live');
          startHeartbeat();
          attemptAutoplay();
          tryAttachWebVttTrack(0);
          setTimeout(refreshCaptionsStatus, 500);
        });
        hls.on(Hls.Events.ERROR, function (event, data) {
          if (data.fatal) setStatus('Stream error: ' + data.details);
        });
        video.textTracks.addEventListener('addtrack', function (e) {
          // iOS Safari's native CC menu doesn't reliably drive hls.js's
          // in-band (JS-added) text tracks into 'showing' mode - it can
          // leave them 'hidden' or flip them to 'disabled' instead. Force
          // the embedded CEA-608 track on so captions render without
          // depending on that platform UI.
          if (e.track && e.track.kind === 'captions' && e.track.label !== 'English CC') {
            e.track.mode = 'showing';
          }
        });
      } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
        video.src = src;
        video.addEventListener('loadedmetadata', function () {
          setStatus('Live');
          startHeartbeat();
          attemptAutoplay();
          tryAttachWebVttTrack(0);
          setTimeout(refreshCaptionsStatus, 500);
        });
      } else {
        setStatus('Your browser does not support HLS playback.');
        setCaptionsStatus('Captions: unavailable (no HLS support in this browser).');
      }
    }

    function pollUntilReady(startedAt, consecutiveFailures) {
      fetch(streamBase + 'ready')
        .then(function (r) { return r.json(); })
        .then(function (state) {
          if (state.ready) {
            playHls();
            return;
          }
          if (state.failed) {
            setStatus(streamFailureText(state.error));
            return;
          }
          if (Date.now() - startedAt > MAX_WAIT_MS) {
            setStatus('Timed out waiting for the stream to start.');
            return;
          }
          setTimeout(function () { pollUntilReady(startedAt, 0); }, POLL_INTERVAL_MS);
        })
        .catch(function () {
          var failures = (consecutiveFailures || 0) + 1;
          if (failures >= READY_RETRY_LIMIT) {
            setStatus('Retrying stream check… network is unstable.');
          }
          if (Date.now() - startedAt > MAX_WAIT_MS) {
            setStatus('Timed out waiting for the stream to start.');
            return;
          }
          setTimeout(function () { pollUntilReady(startedAt, failures); }, POLL_INTERVAL_MS);
        });
    }

    if (recordBtn) {
      recordBtn.addEventListener('click', function () {
        recordBtn.disabled = true;
        recordStatus.textContent = 'Scheduling recording…';
        fetch('/watch/' + encodeURIComponent(channel) + '/record', { method: 'POST' })
          .then(function (r) { return r.json().then(function (body) { return { ok: r.ok, body: body }; }); })
          .then(function (result) {
            if (!result.ok) throw new Error(result.body && result.body.error ? result.body.error : 'Failed to schedule recording');
            var title = result.body.title + (result.body.episodeTitle ? ' - ' + result.body.episodeTitle : '');
            recordStatus.textContent = 'Recording: ' + title;
          })
          .catch(function (err) {
            recordBtn.disabled = false;
            recordStatus.textContent = 'Could not start recording: ' + err.message;
          });
      });
    }

    setStatus('Starting stream (' + profile + ' quality)…');
    bindCaptionTrackListeners();
    refreshCaptionsStatus();
    fetch(streamBase + 'start', { method: 'POST' })
      .then(function () { pollUntilReady(Date.now(), 0); })
      .catch(function () { setStatus('Could not reach the server to start the stream.'); });
  })();
</script>

<%- include('_footer') %>
