<% channels.forEach(function(ch) { %>
  <%- include('_channel_row', { ch }) %>
<% }); %>

<% if (nextOffset < totalChannels) { %>
  <div class="channel-load-more text-center py-2"
       hx-get="/channels/rows?offset=<%= nextOffset %>&limit=<%= limit %>"
       hx-trigger="revealed"
       hx-swap="outerHTML">
    <span class="small text-body-secondary">Loading more channels…</span>
  </div>
<% } %>
