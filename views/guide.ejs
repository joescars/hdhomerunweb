<%- include('_header', { title: 'Guide' }) %>

<div class="d-flex align-items-center mb-3">
  <h1 class="h4 mb-0 flex-grow-1">TV Guide</h1>
  <a href="/guide/grid" class="btn btn-outline-secondary btn-sm">Grid view</a>
</div>

<div id="guide-content"
     hx-get="/guide/fragment"
     hx-trigger="load"
     hx-swap="innerHTML">
  <div class="alert alert-secondary mb-0 d-flex align-items-center gap-2">
    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
    <span>Loading guide data…</span>
  </div>
</div>

<script>
  function hydrateAiringTimes(root) {
    (root || document).querySelectorAll('.airing-time').forEach(function (el) {
      var start = new Date(parseInt(el.dataset.start, 10) * 1000);
      var end = new Date(parseInt(el.dataset.end, 10) * 1000);
      var opts = { hour: 'numeric', minute: '2-digit' };
      el.textContent = start.toLocaleTimeString([], opts) + ' – ' + end.toLocaleTimeString([], opts);
    });
  }

  hydrateAiringTimes(document);

  document.body.addEventListener('htmx:afterSwap', function (event) {
    if (event.target && event.target.id === 'guide-content') {
      hydrateAiringTimes(event.target);
    }
  });
</script>

<%- include('_footer') %>
