<%- include('_client_header', { title: 'TV Guide' }) %>

<div class="d-flex align-items-center flex-wrap gap-2 mb-3">
  <div class="btn-group flex-wrap" role="group" aria-label="Guide filters">
    <input type="checkbox" class="btn-check" id="guide-filter-favorites" autocomplete="off">
    <label class="btn btn-outline-warning btn-sm guide-filter-pill" for="guide-filter-favorites"><i class="bi bi-star-fill me-1"></i>Favorites</label>

    <input type="checkbox" class="btn-check" id="guide-filter-show-hidden" autocomplete="off">
    <label class="btn btn-outline-secondary btn-sm guide-filter-pill" for="guide-filter-show-hidden">Show Hidden</label>
  </div>
  <span class="text-body-secondary small ms-auto" id="guide-channel-count"></span>
  <a href="/guide/grid" class="icon-link" title="Grid view" aria-label="Grid view"><i class="bi bi-grid-3x3-gap"></i></a>
</div>

<div id="guide-content"
     hx-get="/guide/fragment"
     hx-trigger="load"
     hx-swap="innerHTML">
  <div class="alert alert-secondary mb-0 d-flex align-items-center gap-2">
    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
    <span>Loading guide data…</span>
  </div>
</div>
<div id="guide-filter-empty" class="alert alert-secondary mt-2" style="display:none;">
  No channels match the current filters.
</div>

<script>
  var guideFavoritesCheck = document.getElementById('guide-filter-favorites');
  var guideShowHiddenCheck = document.getElementById('guide-filter-show-hidden');
  var guideCountEl = document.getElementById('guide-channel-count');
  var guideEmptyEl = document.getElementById('guide-filter-empty');

  function hydrateAiringTimes(root) {
    (root || document).querySelectorAll('.airing-time').forEach(function (el) {
      var start = new Date(parseInt(el.dataset.start, 10) * 1000);
      var end = new Date(parseInt(el.dataset.end, 10) * 1000);
      var opts = { hour: 'numeric', minute: '2-digit' };
      el.textContent = start.toLocaleTimeString([], opts) + ' – ' + end.toLocaleTimeString([], opts);
    });
  }

  function applyGuideFilters() {
    if (!guideFavoritesCheck || !guideShowHiddenCheck || !guideCountEl) return;
    var items = document.querySelectorAll('#guide-content .guide-item');
    var visible = 0;
    items.forEach(function (item) {
      var isFavorite = item.dataset.favorite === '1';
      var isHidden = item.dataset.hidden === '1';
      var show = (!guideFavoritesCheck.checked || isFavorite) && (guideShowHiddenCheck.checked || !isHidden);
      item.style.display = show ? '' : 'none';
      if (show) visible += 1;
    });

    guideCountEl.textContent = visible + ' channel' + (visible === 1 ? '' : 's');
    if (guideEmptyEl) {
      guideEmptyEl.style.display = (items.length > 0 && visible === 0) ? '' : 'none';
    }
  }

  // Same prewarm-then-navigate pattern as the desktop grid view: pick a
  // quality profile from the connection, fire the stream start request
  // immediately, then navigate shortly after regardless (so the transcode
  // is already spinning up server-side by the time /watch loads instead of
  // starting cold once the page arrives).
  function chooseQualityProfile() {
    var connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
    if (!connection) return 'medium';
    if (connection.saveData) return 'low';
    var effectiveType = connection.effectiveType || '';
    if (effectiveType === 'slow-2g' || effectiveType === '2g' || effectiveType === '3g') return 'low';
    if (typeof connection.downlink === 'number' && connection.downlink >= 8) return 'high';
    if (typeof connection.downlink === 'number' && connection.downlink <= 2.5) return 'low';
    return 'medium';
  }

  function watchChannel(channel) {
    var profile = chooseQualityProfile();
    var encodedChannel = encodeURIComponent(channel);
    var destination = '/watch/' + encodedChannel + '?quality=' + encodeURIComponent(profile);
    var startUrl = '/stream/' + encodedChannel + '/h264/' + encodeURIComponent(profile) + '/start';
    var navigated = false;

    function navigateNow() {
      if (navigated) return;
      navigated = true;
      window.location.href = destination;
    }

    setTimeout(navigateNow, 140);
    fetch(startUrl, { method: 'POST' }).catch(function () {}).finally(navigateNow);
  }

  if (guideShowHiddenCheck) {
    guideShowHiddenCheck.checked = false;
  }

  hydrateAiringTimes(document);
  applyGuideFilters();

  document.body.addEventListener('htmx:afterSwap', function (event) {
    if (event.target && event.target.id === 'guide-content') {
      hydrateAiringTimes(event.target);
      applyGuideFilters();
    }
  });

  [guideFavoritesCheck, guideShowHiddenCheck].forEach(function (el) {
    if (!el) return;
    el.addEventListener('change', applyGuideFilters);
  });
</script>

<%- include('_footer') %>
