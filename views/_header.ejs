<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %> · HDHomeRun</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://unpkg.com/htmx.org@1.9.12" defer></script>
  <script>
    (function () {
      var stored = localStorage.getItem('theme');
      var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-bs-theme', theme);
    })();
  </script>
</head>
<body>
  <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom border-secondary-subtle sticky-top">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">HDHomeRun</a>
      <button type="button" id="theme-toggle" class="btn btn-outline-light btn-sm order-sm-2 ms-auto ms-sm-2" aria-label="Toggle light/dark mode">🌓</button>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navLinks" aria-controls="navLinks" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navLinks">
        <div class="navbar-nav gap-sm-3 pt-2 pt-sm-0">
          <a class="nav-link" href="/guide">Guide</a>
          <a class="nav-link" href="/channels">Channels</a>
          <a class="nav-link" href="/scan">Scan</a>
          <a class="nav-link" href="/status">Status</a>
          <a class="nav-link" href="<%= deviceSystemLogUrl %>" target="_blank" rel="noopener">Log ↗</a>
        </div>
      </div>
    </div>
  </nav>
  <main class="container py-3" style="max-width: 640px;">
