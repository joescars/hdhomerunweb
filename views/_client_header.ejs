<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %> · LunaTV</title>
  <link rel="icon" href="/images/favicon-32.png?v=<%= assetVersion %>" sizes="32x32" type="image/png">
  <link rel="icon" href="/images/favicon-192.png?v=<%= assetVersion %>" sizes="192x192" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=<%= assetVersion %>">
  <meta name="theme-color" content="#0a1428">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- ?v=<%= assetVersion %> busts the cache on every deploy - server.js
       serves /public with maxAge:'7d' + immutable:true (great for
       performance, but means browsers won't even revalidate this file for
       a week without a version bump in the URL itself). assetVersion
       changes on every server restart (Date.now() at boot, or ASSET_VERSION
       env var), so this is a real cache-buster, not just cosmetic. -->
  <link rel="stylesheet" href="/css/client.css?v=<%= assetVersion %>">
  <script src="https://unpkg.com/htmx.org@1.9.12" defer></script>
</head>
<body class="client-theme<% if (typeof bare !== 'undefined' && bare) { %> client-theme-bare<% } %>">
<% if (typeof bare === 'undefined' || !bare) { %>
  <nav class="navbar navbar-expand client-navbar sticky-top">
    <div class="container-fluid align-items-center">
      <a href="/" class="d-flex align-items-center text-decoration-none">
        <img src="/images/logo.png?v=<%= assetVersion %>" alt="LunaTV" class="client-logo">
      </a>
      <a href="/recordings" class="icon-link ms-auto me-3" title="Recordings" aria-label="Recordings">
        <i class="bi bi-collection-play"></i>
      </a>
      <a href="/admin" class="icon-link" title="Admin" aria-label="Admin">
        <i class="bi bi-gear"></i>
      </a>
    </div>
  </nav>
  <main class="container py-3"<% if (typeof fluid === 'undefined' || !fluid) { %> style="max-width: 640px;"<% } %>>
<% } else { %>
  <main class="p-0">
<% } %>
