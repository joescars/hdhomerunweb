# Copy to roku/.env and fill in. Used by deploy.sh; gitignored.

# Your Roku's LAN IP (Settings -> Network -> About, or the Developer Settings screen)
ROKU_IP=192.168.1.50

# The Developer Mode password you set when enabling it on the device.
# NOT your Roku account password.
ROKU_DEV_PASSWORD=changeme

# Base URL for the hdhomerun-web server, embedded into the packaged Roku app.
# A URL saved from the app's Settings screen takes precedence.
HDHOMERUN_WEB_URL=http://192.168.1.100:8080
