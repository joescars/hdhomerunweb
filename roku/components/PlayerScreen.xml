<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScreen" extends="Group">
    <interface>
        <!-- in -->
        <field id="serverUrl" type="string" />
        <field id="channelNumber" type="string" />
        <field id="channelName" type="string" />
        <field id="streamPath" type="string" />
        <!-- out: fires when the user backs out of the player -->
        <field id="closed" type="boolean" alwaysNotify="true" />
        <!-- callable from MainScene -->
        <function name="onScreenFocus" />
    </interface>

    <children>
        <Video id="video"
            translation="[0, 0]"
            width="1920"
            height="1080"
            visible="false" />

        <Rectangle id="overlayBg"
            translation="[0, 0]"
            width="1920"
            height="1080"
            color="0x000000FF"
            visible="false" />

        <BusySpinner id="spinner"
            translation="[910, 440]"
            visible="false" />

        <Label id="statusLabel"
            translation="[0, 580]"
            width="1920"
            height="80"
            horizAlign="center"
            vertAlign="center"
            color="0xFFFFFFFF"
            visible="false" />

        <Label id="hintLabel"
            translation="[0, 660]"
            width="1920"
            height="50"
            horizAlign="center"
            vertAlign="center"
            color="0xAAAAAAFF"
            visible="false" />
    </children>

    <script type="text/brightscript" uri="PlayerScreen.brs" />
</component>
