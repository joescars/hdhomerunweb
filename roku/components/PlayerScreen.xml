<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScreen" extends="Group">
    <interface>
        <!-- in -->
        <field id="serverUrl" type="string" />
        <field id="channelNumber" type="string" />
        <field id="channelName" type="string" />
        <field id="codec" type="string" />
        <field id="streamPath" type="string" />
        <!-- in: ordered list of visible channels for rewind/forward surfing -->
        <field id="channels" type="array" />
        <!-- in: current/next program titles for the now/next info overlay -->
        <field id="currentTitle" type="string" />
        <field id="nextTitle" type="string" />
        <!-- out: fires when the user backs out of the player -->
        <field id="closed" type="boolean" alwaysNotify="true" />
        <!-- callable from MainScene -->
        <function name="onScreenFocus" />
    </interface>

    <children>
        <Timer id="statsTimer" repeat="true" duration="2.5" />

        <Video id="video"
            translation="[0, 0]"
            width="1920"
            height="1080"
            visible="false" />

        <Rectangle id="overlayBg"
            translation="[0, 0]"
            width="1920"
            height="1080"
            color="0x000000FF"
            visible="false" />

        <BusySpinner id="spinner"
            translation="[910, 440]"
            visible="false" />

        <Label id="statusLabel"
            translation="[0, 580]"
            width="1920"
            height="80"
            horizAlign="center"
            vertAlign="center"
            color="0xFFFFFFFF"
            visible="false" />

        <Label id="hintLabel"
            translation="[0, 660]"
            width="1920"
            height="50"
            horizAlign="center"
            vertAlign="center"
            color="0xAAAAAAFF"
            visible="false" />

        <Group id="channelInfoOverlay" translation="[0, 900]" visible="false">
            <Rectangle width="1920" height="180" color="0x0A1428E6" />
            <Rectangle width="1920" height="3" color="0x38BDF8FF" />
            <Label id="infoChannelLabel"
                translation="[60, 20]"
                width="1800"
                height="46"
                font="font:LargeBoldSystemFont"
                color="0xFFFFFFFF" />
            <Label id="infoNowLabel"
                translation="[60, 78]"
                width="1800"
                height="40"
                font="font:MediumBoldSystemFont"
                color="0x38BDF8FF" />
            <Label id="infoNextLabel"
                translation="[60, 122]"
                width="1800"
                height="36"
                font="font:SmallSystemFont"
                color="0x9CB0C4FF" />
            <Group id="recordingIndicator" translation="[1700, 20]" visible="false">
                <Rectangle width="150" height="42" color="0xDC2626FF" />
                <Label translation="[0, 0]" width="150" height="42" text="REC" font="font:MediumBoldSystemFont" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" />
            </Group>
        </Group>

        <Timer id="infoHideTimer" duration="5" repeat="false" />

        <Group id="statsPanel" translation="[46, 44]" visible="false">
            <Rectangle
                width="920"
                height="460"
                color="0x0A1428EE" />
            <Rectangle
                width="920"
                height="3"
                color="0x38BDF8FF" />
            <Label id="statsTitle"
                translation="[20, 10]"
                width="880"
                height="34"
                font="font:SmallBoldSystemFont"
                color="0xFFFFFFFF"
                text="Stream diagnostics" />
            <Label id="statsBody"
                translation="[20, 54]"
                width="880"
                height="360"
                font="font:SmallSystemFont"
                wrap="true"
                color="0xD0D0D0FF" />
            <Label id="statsHint"
                translation="[20, 418]"
                width="880"
                height="28"
                font="font:SmallSystemFont"
                color="0x91A4B8FF"
                text="Up: hide diagnostics   Back: return to Guide" />
        </Group>
    </children>

    <script type="text/brightscript" uri="PlayerScreen.brs" />
</component>
