<?xml version="1.0" encoding="utf-8" ?>
<component name="SettingsScreen" extends="Group">
    <interface>
        <!-- in -->
        <field id="serverUrl" type="string" />
        <field id="streamCodec" type="string" />
        <field id="livePreviewEnabled" type="boolean" />
        <!-- out: fires with the new URL string when the user saves -->
        <field id="saved" type="string" alwaysNotify="true" />
        <!-- out: fires with the selected codec when changed -->
        <field id="codecSaved" type="string" alwaysNotify="true" />
        <!-- out: fires with the new on/off state when changed -->
        <field id="livePreviewSaved" type="boolean" alwaysNotify="true" />
        <!-- out: fires when the user backs out -->
        <field id="closed" type="boolean" alwaysNotify="true" />
        <!-- callable from MainScene -->
        <function name="onScreenFocus" />
    </interface>

    <children>
        <Rectangle translation="[0, 0]" width="1920" height="1080" color="0x050A12FF" />

        <Group translation="[260, 100]">
            <Rectangle width="1400" height="930" color="0x0A1428F4" />
            <Rectangle width="1400" height="4" color="0x38BDF8FF" />

            <Label
                translation="[56, 40]"
                width="1288"
                height="58"
                font="font:LargeBoldSystemFont"
                text="Settings"
                color="0xFFFFFFFF" />

            <Label
                translation="[56, 102]"
                width="1288"
                height="34"
                font="font:SmallSystemFont"
                text="Configure the HDHomeRun Web server URL used by this Roku client."
                color="0xA7B7C7FF" />

            <Label
                translation="[56, 180]"
                width="1288"
                height="34"
                font="font:SmallBoldSystemFont"
                text="Server URL"
                color="0xE2E8F0FF" />

            <Rectangle
                id="urlBox"
                translation="[56, 224]"
                width="1288"
                height="86"
                color="0x101D33FF" />
            <Rectangle
                translation="[56, 224]"
                width="1288"
                height="2"
                color="0x334155FF" />
            <Label
                id="urlLabel"
                translation="[82, 244]"
                width="1236"
                height="46"
                font="font:MediumSystemFont"
                color="0xFFFFFFFF" />

            <Label
                translation="[56, 342]"
                width="1288"
                height="70"
                font="font:SmallSystemFont"
                wrap="true"
                text="Press OK to edit the server URL. Use an http:// or https:// address with a server host."
                color="0x9CB0C4FF" />

            <Label
                translation="[56, 426]"
                width="1288"
                height="34"
                font="font:SmallBoldSystemFont"
                text="Streaming Mode"
                color="0xE2E8F0FF" />

            <Rectangle
                translation="[56, 470]"
                width="1288"
                height="72"
                color="0x101D33FF" />
            <Rectangle
                translation="[56, 470]"
                width="1288"
                height="2"
                color="0x334155FF" />
            <Label
                id="codecLabel"
                translation="[82, 488]"
                width="1236"
                height="38"
                font="font:MediumSystemFont"
                color="0xFFFFFFFF" />

            <Label
                translation="[56, 554]"
                width="1288"
                height="66"
                font="font:SmallSystemFont"
                wrap="true"
                text="Left/Right cycles H.264 / HEVC / Direct. Direct skips server transcoding entirely and is experimental - it may not play at all on this device."
                color="0x9CB0C4FF" />

            <Label
                translation="[56, 630]"
                width="1288"
                height="34"
                font="font:SmallBoldSystemFont"
                text="Live Preview"
                color="0xE2E8F0FF" />

            <Rectangle
                translation="[56, 664]"
                width="1288"
                height="60"
                color="0x101D33FF" />
            <Rectangle
                translation="[56, 664]"
                width="1288"
                height="2"
                color="0x334155FF" />
            <Label
                id="livePreviewLabel"
                translation="[82, 664]"
                width="1236"
                height="60"
                vertAlign="center"
                font="font:MediumSystemFont"
                color="0xFFFFFFFF" />

            <Label
                translation="[56, 730]"
                width="1288"
                height="56"
                font="font:SmallSystemFont"
                wrap="true"
                text="Up/Down toggles live preview while browsing the guide. Turn off if you have few tuners - each preview uses one while it plays."
                color="0x9CB0C4FF" />

            <Label
                id="statusLabel"
                translation="[56, 800]"
                width="1288"
                height="40"
                font="font:SmallSystemFont"
                color="0x38BDF8FF" />

            <Rectangle
                translation="[56, 858]"
                width="1288"
                height="62"
                color="0x0F1D30FF" />
            <Label
                translation="[84, 876]"
                width="1228"
                height="28"
                font="font:SmallSystemFont"
                text="OK: Edit URL   Left/Right: Mode   Up/Down: Preview   Back: Return to Guide"
                color="0xB6C7D8FF" />
        </Group>
    </children>

    <script type="text/brightscript" uri="SettingsScreen.brs" />
</component>
