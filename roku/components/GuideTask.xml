<?xml version="1.0" encoding="utf-8" ?>
<component name="GuideTask" extends="Task">
    <interface>
        <!-- in: server base URL, no trailing slash, e.g. http://192.168.68.121:8080 -->
        <field id="serverUrl" type="string" />
        <!-- out: { success, errorMessage, serverTime, channels } - see GuideTask.brs -->
        <field id="guideResult" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/Net.brs" />
    <script type="text/brightscript" uri="GuideTask.brs" />
</component>
