<?xml version="1.0" encoding="utf-8" ?>
<component name="UrlCheckTask" extends="Task">
    <interface>
        <!-- in: server base URL, no trailing slash -->
        <field id="serverUrl" type="string" />
        <!-- out: { success: boolean, code: integer, error: string } -->
        <field id="result" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/Net.brs" />
    <script type="text/brightscript" uri="UrlCheckTask.brs" />
</component>
