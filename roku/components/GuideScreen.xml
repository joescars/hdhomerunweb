<?xml version="1.0" encoding="utf-8" ?>
<component name="GuideScreen" extends="Group">
    <interface>
        <!-- in -->
        <field id="serverUrl" type="string" />
        <!-- out: { channelNumber, channelName, streamPath } - fires when the user selects a channel/program -->
        <field id="launchPlayer" type="assocarray" alwaysNotify="true" />
        <!-- out: fires when the user presses the Options remote button -->
        <field id="openSettings" type="boolean" alwaysNotify="true" />
        <!-- callable from MainScene -->
        <function name="refreshGuide" />
        <function name="onScreenFocus" />
    </interface>

    <children>
        <Timer id="refreshTimer" repeat="true" duration="300" />

        <TimeGrid id="timeGrid"
            translation="[0, 0]"
            nowNextMode="false"
            duration="7200"
            channelInfoWidth="300"
            channelInfoColumnLabel="Channels"
            infoGridGap="4"
            programHorizMargin="18"
            programTitleColor="0xE2E8F0FF"
            programTitleFocusedColor="0x0A1428FF"
            fillProgramGaps="true"
            automaticLoadingDataFeedback="false"
            channelNoDataText="No program data" />

        <Group id="detailPanel" translation="[0, 520]">
            <Rectangle
                translation="[0, 0]"
                width="1920"
                height="560"
                color="0x0A1428FF" />
            <Rectangle
                translation="[0, 0]"
                width="1920"
                height="3"
                color="0x38BDF8FF" />
            <Label id="detailTitle"
                translation="[40, 42]"
                width="1840"
                height="60"
                color="0xFFFFFFFF" />
            <Label id="detailSynopsis"
                translation="[40, 112]"
                width="1840"
                height="180"
                wrap="true"
                color="0xCCCCCCFF" />
            <Label id="hintLabel"
                text="Options ( * ) : Settings"
                translation="[1480, 500]"
                width="380"
                height="40"
                horizAlign="right"
                color="0xAAAAAAFF" />
        </Group>

        <!-- Full-screen overlay used for loading state and fatal guide errors. -->
        <Rectangle id="statusBg"
            translation="[0, 0]"
            width="1920"
            height="1080"
            color="0x0A1428FF"
            visible="false" />
        <Label id="statusLabel"
            translation="[0, 0]"
            width="1920"
            height="1080"
            horizAlign="center"
            vertAlign="center"
            color="0xFFFFFFFF"
            visible="false" />
    </children>

    <script type="text/brightscript" uri="GuideScreen.brs" />
</component>
