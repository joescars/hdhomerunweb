<?xml version="1.0" encoding="utf-8" ?>
<component name="GuideScreen" extends="Group">
    <interface>
        <!-- in -->
        <field id="serverUrl" type="string" />
        <!-- out: { channelNumber, channelName, streamPath } - fires when the user selects a channel/program -->
        <field id="launchPlayer" type="assocarray" alwaysNotify="true" />
        <!-- out: fires when the user presses the Options remote button -->
        <field id="openSettings" type="boolean" alwaysNotify="true" />
        <!-- callable from MainScene -->
        <function name="refreshGuide" />
        <function name="onScreenFocus" />
    </interface>

    <children>
        <Timer id="refreshTimer" repeat="true" duration="300" />

        <Group id="guideHeader" translation="[0, 0]">
            <Rectangle width="1920" height="50" color="0x142238FF" />
            <Label translation="[24, 0]" width="276" height="50" text="Channel" font="font:SmallBoldSystemFont" vertAlign="center" />
            <Label id="firstTimeLabel" translation="[324, 0]" width="456" height="50" font="font:SmallBoldSystemFont" vertAlign="center" />
            <Label id="secondTimeLabel" translation="[804, 0]" width="456" height="50" font="font:SmallBoldSystemFont" vertAlign="center" />
            <Label id="thirdTimeLabel" translation="[1284, 0]" width="612" height="50" font="font:SmallBoldSystemFont" vertAlign="center" />
        </Group>

        <MarkupGrid id="guideGrid"
            translation="[0, 52]"
            itemComponentName="GuideRow"
            itemSize="[1920, 60]"
            itemSpacing="[0, 2]"
            numColumns="1"
            numRows="14"
            clippingRect="[0, 0, 1920, 866]"
            drawFocusFeedback="false"
            vertFocusAnimationStyle="fixedFocusWrap" />

        <Group id="detailPanel" translation="[0, 920]">
            <Rectangle
                translation="[0, 0]"
                width="1920"
                height="140"
                color="0x0A1428FF" />
            <Rectangle
                translation="[0, 0]"
                width="1920"
                height="3"
                color="0x38BDF8FF" />
            <Label id="detailTitle"
                translation="[28, 14]"
                width="1864"
                height="38"
                font="font:SmallSystemFont"
                color="0xFFFFFFFF" />
            <Label id="detailSynopsis"
                translation="[28, 54]"
                width="1864"
                height="72"
                font="font:SmallSystemFont"
                wrap="true"
                color="0xCCCCCCFF" />
        </Group>

        <!-- Full-screen overlay used for loading state and fatal guide errors. -->
        <Rectangle id="statusBg"
            translation="[0, 0]"
            width="1920"
            height="1080"
            color="0x0A1428FF"
            visible="false" />
        <Label id="statusLabel"
            translation="[0, 0]"
            width="1920"
            height="1080"
            horizAlign="center"
            vertAlign="center"
            color="0xFFFFFFFF"
            visible="false" />
    </children>

    <script type="text/brightscript" uri="GuideScreen.brs" />
</component>
