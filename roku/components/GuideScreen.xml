<?xml version="1.0" encoding="utf-8" ?>
<component name="GuideScreen" extends="Group">
    <interface>
        <!-- in -->
        <field id="serverUrl" type="string" />
        <!-- in: most-recent-first array of channel-number strings, from MainScene's registry-backed tracking -->
        <field id="recentChannels" type="array" onChange="onRecentChannelsChange" />
        <!-- in: Settings toggle - each preview holds a tuner while it plays,
             so users with few tuners can turn this off -->
        <!-- alwaysNotify matters here: a boolean field's implicit default is
             false, so setting it to false on a freshly-created node (e.g.
             the user has the setting off) would otherwise be a same-value
             no-op that never fires onChange, leaving the screen's internal
             state stuck at init()'s default (true) instead. -->
        <field id="livePreviewEnabled" type="boolean" alwaysNotify="true" onChange="onLivePreviewEnabledChange" />
        <!-- out: { channelNumber, channelName, streamPath } - fires when the user selects a channel/program -->
        <field id="launchPlayer" type="assocarray" alwaysNotify="true" />
        <!-- out: fires when the user presses the Options remote button -->
        <field id="openSettings" type="boolean" alwaysNotify="true" />
        <!-- callable from MainScene -->
        <function name="refreshGuide" />
        <function name="onScreenFocus" />
    </interface>

    <children>
        <Timer id="refreshTimer" repeat="true" duration="300" />

        <Group id="guideHeader" translation="[0, 0]">
            <Rectangle width="1920" height="50" color="0x142238FF" />
            <Label translation="[24, 0]" width="276" height="50" text="Channel" font="font:SmallBoldSystemFont" vertAlign="center" />
            <Label id="firstTimeLabel" translation="[324, 0]" width="456" height="50" font="font:SmallBoldSystemFont" vertAlign="center" />
            <Label id="secondTimeLabel" translation="[804, 0]" width="456" height="50" font="font:SmallBoldSystemFont" vertAlign="center" />
            <Label id="thirdTimeLabel" translation="[1284, 0]" width="456" height="50" font="font:SmallBoldSystemFont" vertAlign="center" />
            <Label id="filterLabel" translation="[1440, 0]" width="466" height="50" font="font:SmallSystemFont" horizAlign="right" vertAlign="center" color="0xBFD2E6FF" />
        </Group>

        <MarkupGrid id="guideGrid"
            translation="[0, 52]"
            itemComponentName="GuideRow"
            itemSize="[1920, 60]"
            itemSpacing="[0, 2]"
            numColumns="1"
            numRows="14"
            clippingRect="[0, 0, 1920, 866]"
            drawFocusFeedback="false"
            vertFocusAnimationStyle="fixedFocusWrap" />

        <Group id="detailPanel" translation="[0, 920]">
            <Rectangle
                translation="[0, 0]"
                width="1920"
                height="160"
                color="0x0A1428FF" />
            <Rectangle
                translation="[0, 0]"
                width="1920"
                height="3"
                color="0x38BDF8FF" />
            <Label id="detailTitle"
                translation="[28, 14]"
                width="1550"
                height="38"
                font="font:SmallSystemFont"
                color="0xFFFFFFFF" />
            <Label id="detailSynopsis"
                translation="[28, 54]"
                width="1550"
                height="96"
                font="font:SmallSystemFont"
                wrap="true"
                color="0xCCCCCCFF" />

            <!-- Live preview of the currently-focused channel. Tuned after a
                 debounce once focus settles (see GuideScreen.brs) so
                 scrolling through channels doesn't spam the transcode
                 server/tuner with a request per row. Silent on failure -
                 a background preview should never interrupt browsing.
                 previewThumbnail (the channel logo, already fetched for
                 GuideRow) updates instantly on focus change, underneath
                 previewVideo - visible immediately, while buffering, while
                 disabled (Settings > Live Preview > Off), and on any
                 preview failure, since the video only visually covers it
                 once real frames arrive. -->
            <Rectangle translation="[1600, 2]" width="280" height="157" color="0x000000FF" />
            <Poster id="previewThumbnail" translation="[1600, 2]" width="280" height="157" loadDisplayMode="scaleToFit" />
            <Video id="previewVideo" translation="[1600, 2]" width="280" height="157" visible="false" />
            <Rectangle translation="[1600, 2]" width="280" height="2" color="0x38BDF8FF" />
            <Label id="previewLabel"
                translation="[1600, 132]"
                width="280"
                height="26"
                font="font:SmallBoldSystemFont"
                horizAlign="center"
                vertAlign="center"
                color="0xFFFFFFFF"
                text="" />
        </Group>

        <Timer id="previewDebounceTimer" duration="0.9" repeat="false" />

        <!-- Full-screen overlay used for loading state and fatal guide errors. -->
        <Rectangle id="statusBg"
            translation="[0, 0]"
            width="1920"
            height="1080"
            color="0x0A1428FF"
            visible="false" />
        <Label id="statusLabel"
            translation="[0, 0]"
            width="1920"
            height="1080"
            horizAlign="center"
            vertAlign="center"
            color="0xFFFFFFFF"
            visible="false" />
    </children>

    <script type="text/brightscript" uri="GuideScreen.brs" />
</component>
