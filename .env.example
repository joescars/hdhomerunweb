# hdhomerun.local (mDNS) does not resolve from inside a container on the
# default bridge network. Use your device's LAN IP instead (see README for
# how to find it).
HDHOMERUN_HOST=192.168.1.100
HDHOMERUN_PORT=80

# Optional live-stream tuning toggles
# Decode mode: sw (default) or qsv. sw is required for embedded closed
# captions to survive transcoding - full hardware (qsv) decode does not
# propagate A/53 CC data to the encoder. Costs CPU per concurrent stream;
# set to qsv only if you don't need captions and want lower CPU usage.
STREAM_DECODE_MODE=sw

# WebVTT caption sidecar generation (on/off). Off by default: blocked by an
# unfixed upstream ffmpeg bug (EIA-608 "columns exceeding screen width"
# drops every cue - https://trac.ffmpeg.org/ticket/11101) that produces an
# empty captions.vtt regardless of source captions. Embedded CEA-608
# captions (via STREAM_DECODE_MODE=sw) are the reliable path; this is kept
# as an opt-in fallback in case the ffmpeg bug is fixed upstream.
WEBVTT_SIDECAR_MODE=off

# Raw input caption probe in diagnostics (on/off). Keep off unless debugging.
SOURCE_CAPTION_PROBE=off

# Optional: enables the "Record this airing" button on the watch page.
# Points at a separately-run HDHomeRun RECORD engine (the Silicondust DVR
# process/binary - not something this app manages or containerizes). Use
# the host's LAN IP, not "localhost" - the record engine runs on the Docker
# host, not inside this app's container. Leave RECORD_ENGINE_HOST unset to
# disable the feature entirely.
RECORD_ENGINE_HOST=
RECORD_ENGINE_PORT=37899
